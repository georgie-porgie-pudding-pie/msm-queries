<h1>Actor #<%= @id %> details</h1>

<a href="/actors">Go back</a>

<hr>

<p>Name</p>
<p><%= @name%></p>
<p>Dob</p>
<p><%= @dob%></p>
<p>Bio</p>
<p><%= @bio%></p>
<p>Image</p>
<img src="<%= @image%>" width=200>
<p>Creataed at</p>
<p><%= @created%></p>
<p>Updated at</p>
<p><%= @updated%></p>

<hr>

<h2>Filmography</h2>

<table>
  <tr>
    <th>Title</th>
    <th>Year</th>
    <th>Director</th>
    <th>Character name</th>
    <th></th>
  </tr>
  <% @list_of_characters.each do |the_item| %>
    <tr>
      <td><%= Movie.where({ :id => the_item.movie_id}).at(0).title %></td>
      <td><%= Movie.where({ :id => the_item.movie_id}).at(0).year %></td>
      <td><%= Director.where({ :id => Movie.where({ :id => the_item.movie_id}).at(0).director_id}).at(0).name
       %></td>
      <td><%= the_item.name %></td>
      <td><a href="/movies/<%= the_item.movie_id %>">Show details<a></td>
    <tr>
  <% end %>
</table>
